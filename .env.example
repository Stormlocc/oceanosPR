# OCEANOS PR — credenciales externas
#
# NO pongas credenciales reales en este archivo: está versionado en git.
# El metodo recomendado por ACOLITE es ~/.netrc con permisos 600:
#
#   machine earthdata
#   login   TU_USUARIO
#   password TU_CLAVE
#
#   machine cdse
#   login   TU_CORREO
#   password TU_CLAVE
#
# Alternativa por variables de entorno. Los nombres son los que ACOLITE lee
# (no EARTHDATA_USERNAME/PASSWORD, que no lee nadie):
EARTHDATA_u=
EARTHDATA_p=
CDSE_u=
CDSE_p=
